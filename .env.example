# Copy to .env and adjust. Never commit .env.

# Postgres + PostGIS
POSTGRES_USER=droneverse
POSTGRES_PASSWORD=change-me
POSTGRES_DB=droneverse
POSTGRES_PORT=5432
DATABASE_URL=postgresql://droneverse:change-me@localhost:5432/droneverse

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me-too
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=droneverse

# API
API_HOST=0.0.0.0
API_PORT=3001

# Hosted Supabase (no Docker): use the "Session pooler" string from
# Project -> Connect. The direct db.<ref>.supabase.co host is IPv6-only.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
