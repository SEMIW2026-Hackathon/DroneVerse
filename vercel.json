{
  "services": {
    "web": { "root": "apps/web", "installCommand": "cd ../.. && pnpm install" },
    "api": {
      "root": "apps/api",
      "framework": "fastify",
      "entrypoint": "src/server.ts",
      "installCommand": "cd ../.. && pnpm install"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}