{
  "name": "@droneverse/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@droneverse/shared": "workspace:*",
    "fastify": "^5.0.0",
    "pg": "^8.23.1",
    "ws": "^8.18.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "tsx": "^4.19.0",
    "vitest": "^2.1.0"
  }
}
